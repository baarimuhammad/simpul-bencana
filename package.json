{
  "name": "simpul-bencana",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/start.mjs",
    "dev:vite": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:functions",
    "deploy": "node scripts/deploy.mjs",
    "format": "prettier --write src server netlify tests scripts *.json *.ts *.js *.html *.md docs",
    "check:functions": "node scripts/check-functions.mjs"
  },
  "dependencies": {
    "jspdf": "4.2.1",
    "lucide-react": "1.60.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@netlify/functions": "6.0.3",
    "@netlify/zip-it-and-ship-it": "16.4.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "topojson-client": "3.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "world-atlas": "2.0.2"
  }
}
